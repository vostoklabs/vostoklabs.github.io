{
  "name": "laser-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Image-to-slot-together laser-cut model generator (crossed profiles + slotted base, DXF/SVG export).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test:geometry": "esbuild tests/solver.mts --bundle --platform=node --format=esm --external:manifold-3d --outfile=node_modules/.cache/solver.mjs --log-level=error && node node_modules/.cache/solver.mjs",
    "demo": "esbuild scripts/demo.mts --bundle --platform=node --format=esm --external:manifold-3d --outfile=node_modules/.cache/demo.mjs --log-level=error && node node_modules/.cache/demo.mjs",
    "samples": "esbuild scripts/traceSamples.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/samples.mjs --log-level=error && node node_modules/.cache/samples.mjs"
  },
  "dependencies": {
    "@vostok/brand": "workspace:*",
    "@vostok/plates": "workspace:*",
    "@vostok/ui-kit": "workspace:*",
    "@vostok/viewer": "workspace:*",
    "d3-contour": "^4.0.2",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.0.1",
    "pica": "^10.0.2",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/three": "^0.171.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
