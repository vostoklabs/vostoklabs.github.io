{
  "name": "generator-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "esbuild tests/geometry.test.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/geometry.test.mjs --log-level=error && node node_modules/.cache/geometry.test.mjs"
  },
  "dependencies": {
    "@vostok/brand": "workspace:*",
    "@vostok/export": "workspace:*",
    "@vostok/fonts": "workspace:*",
    "@vostok/plates": "workspace:*",
    "@vostok/shapes": "workspace:*",
    "@vostok/ui-kit": "workspace:*",
    "@vostok/viewer": "workspace:*",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
