{
  "name": "@vostok/trace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A picture or an SVG file into shapes: the image tracer (decode, crop and adjust, remove the background, reduce the colours, trace the outlines) and the SVG reader, both answering normalised rings per colour that the apps scale into millimetres.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "esbuild tests/svg-reader.test.ts --bundle --platform=node --format=esm --external:@xmldom/xmldom --outfile=node_modules/.cache/svg-reader.test.mjs --log-level=error && node node_modules/.cache/svg-reader.test.mjs"
  },
  "dependencies": {
    "d3-contour": "^4.0.2",
    "pica": "^10.0.2",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/three": "^0.171.0",
    "@xmldom/xmldom": "^0.9.10",
    "esbuild": "^0.24.2",
    "lucide": "^1.21.0",
    "typescript": "^5.7.2"
  }
}
