{
  "name": "@vostok/export",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared model exporters: multi-part 3MF (Bambu/Orca filament slots), binary STL, OBJ.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "esbuild src/bambuProfile.check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/bambuProfile.check.mjs --log-level=error && node node_modules/.cache/bambuProfile.check.mjs",
    "profile:build": "node scripts/build-bambu-profile.mjs"
  },
  "dependencies": {
    "@vostok/brand": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
