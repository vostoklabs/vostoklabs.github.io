{
  "name": "vostok-labs-tools",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "new:generator": "node scripts/new-generator.mjs",
    "dev:template": "pnpm --filter generator-template dev",
    "build:template": "pnpm --filter generator-template build",
    "dev:hub": "pnpm --filter hub dev",
    "build:hub": "pnpm --filter hub build",
    "dev:demo": "pnpm --filter kit-demo dev",
    "build:demo": "pnpm --filter kit-demo build",
    "dev:keychain": "pnpm --filter name-keychain dev",
    "build:keychain": "pnpm --filter name-keychain build",
    "dev:clicker": "pnpm --filter clicker-generator dev",
    "build:clicker": "pnpm --filter clicker-generator build",
    "dev:keycap": "pnpm --filter keycap-generator dev",
    "build:keycap": "pnpm --filter keycap-generator build",
    "dev:magnet": "pnpm --filter magnet-generator dev",
    "build:magnet": "pnpm --filter magnet-generator build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @vostok/ui-kit test && pnpm --filter @vostok/fonts test && pnpm --filter @vostok/export check && pnpm --filter @vostok/patterns test && node packages/laser/tests/csg2d.test.mjs && node packages/laser/tests/glyph-islands.test.mjs && node packages/manifold/tests/manifold.test.mjs && pnpm --filter house-number check && pnpm --filter house-number check:build",
    "test:clicker": "esbuild apps/clicker-generator/tests/fit-controls.test.ts --bundle --platform=node --format=esm --external:manifold-3d --outfile=apps/clicker-generator/.fit-test.mjs --log-level=error && node apps/clicker-generator/.fit-test.mjs",
    "dev:housenumber": "pnpm --filter house-number dev",
    "build:housenumber": "pnpm --filter house-number build",
    "dev:bubblepop": "pnpm --filter bubble-pop-generator dev",
    "build:bubblepop": "pnpm --filter bubble-pop-generator build",
    "check:chrome": "node scripts/check-app-chrome.mjs",
    "check:ui": "node scripts/check-ui-drift.mjs",
    "check:public": "node scripts/check-public.mjs --all",
    "check:manifold": "node scripts/check-manifold.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "check:catalogue": "node scripts/catalogue.mjs --check",
    "check:blocks": "node scripts/check-blocks.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:copies": "node scripts/check-copies.mjs",
    "check:shelf": "node scripts/catalogue.mjs --check && node scripts/check-blocks.mjs && node scripts/check-layers.mjs && node scripts/check-copies.mjs",
    "gen:licenses": "node scripts/licenses.mjs",
    "check:licenses": "node scripts/licenses.mjs --check",
    "build:offline": "node scripts/offline.mjs",
    "dev:penTopper": "pnpm --filter pen-topper dev",
    "build:penTopper": "pnpm --filter pen-topper build",
    "dev:foldbox": "pnpm --filter foldbox dev:print",
    "build:foldbox": "pnpm --filter foldbox build",
    "render:topper": "node scripts/render-topper.mjs",
    "dev:keychainCarabiner": "pnpm --filter keychain-carabiner dev",
    "build:keychainCarabiner": "pnpm --filter keychain-carabiner build",
    "gen:notices": "node scripts/third-party-notices.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check",
    "dev:laserStudio": "pnpm --filter laser-studio dev",
    "build:laserStudio": "pnpm --filter laser-studio build",
    "render:laserStudioThumb": "node scripts/render-laser-studio-thumb.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "fflate": "^0.8.3"
  }
}
